# LitVM Liteforge testnet RPC (verify current value at testnet.litvm.com)
LITVM_RPC=https://liteforge.rpc.caldera.xyz/infra-partner-http

# Throwaway deployer wallet — only needs testnet zkLTC from the faucet for gas.
# Generate with: npm run generate-wallets
DEPLOYER_PRIVATE_KEY=0xYOUR_THROWAWAY_DEPLOYER_PRIVATE_KEY

# Recipients for the 90/10 split — generate with: npm run generate-wallets
TREASURY_WALLET=0xYOUR_TREASURY_WALLET_ADDRESS
OPERATIONS_FUND_WALLET=0xYOUR_OPERATIONS_FUND_WALLET_ADDRESS

# Initial unlock price in wei (native zkLTC, 18 decimals). ~$1 equivalent —
# compute with scripts/setPrice.js once you have a current LTC/USD quote,
# or start with a placeholder like 1000000000000000 (0.001 zkLTC) for testing.
INITIAL_UNLOCK_PRICE_WEI=1000000000000000

# Set after deploying, needed by scripts/setPrice.js
UNLOCK_CONTRACT_ADDRESS=

# Optional. If set, deploy.js transfers contract ownership to this address
# immediately after deployment (or run `npm run transfer-ownership:liteforge`
# later). Owner can call setUnlockPrice / setTreasury / setOperationsFund — on
# testnet this can stay unset (deployer keeps ownership); before mainnet,
# set this to a hardware wallet or multisig address, NOT another hot key.
NEW_OWNER=
