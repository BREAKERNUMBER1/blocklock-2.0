# Server
PORT=3001
# Local dev default shown below; in production set this to https://dlb.tech
FRONTEND_URL=http://localhost:5173

# LitVM Liteforge testnet RPC (verify current value at testnet.litvm.com)
LITVM_RPC=https://liteforge.rpc.caldera.xyz/infra-partner-http

# PayToUnlock contract address — filled in after running: npm run deploy:liteforge in /contracts
UNLOCK_CONTRACT_ADDRESS=0xYOUR_DEPLOYED_PAYTOUNLOCK_ADDRESS

# Security — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
MQTT_HMAC_SECRET=GENERATE_A_LONG_RANDOM_STRING_HERE

# MQTT Broker (Mosquitto on your server) — use the domain, not a bare IP,
# since the TLS cert is issued for dlb.tech
MQTT_BROKER_URL=mqtts://dlb.tech:8883
MQTT_USERNAME=blocklock
MQTT_PASSWORD=GENERATE_A_STRONG_PASSWORD_HERE

# Discord webhook for unlock notifications (optional — leave blank to disable)
DISCORD_WEBHOOK_URL=
